# Copy to .env.demo for local competition demos.
# demo.sh loads config/api_keys.env first, then overrides with .env.demo.

QWEN_USE_MOCK=true
QWEATHER_USE_MOCK=true
QWEATHER_MOCK_HUMIDITY=70
RAG_ENABLED=false

DRONE_BACKEND=px4
MUYE_TAKEOFF_MODE=manual
PX4_AUTO_START_ON_SPRAY=true
PX4_RETURN_TO_LAUNCH_AFTER_MISSION=false
PX4_REQUIRE_GLOBAL_POSITION=false
PX4_ALLOW_FORCE_ARM=true
PX4_EXECUTION_MODE=animated_demo
PX4_USE_EXISTING_MISSION=false
PX4_REQUIRE_EXISTING_MISSION=false
