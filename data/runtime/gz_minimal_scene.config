<?xml version="1.0"?>
<gui version="1.0">
  <plugin filename="TransportSceneManager" name="Scene Manager">
    <gz-gui>
      <property key="state" type="string">invisible</property>
    </gz-gui>
  </plugin>

  <plugin filename="InteractiveViewControl" name="View Control">
    <gz-gui>
      <property key="state" type="string">floating</property>
      <property key="width" type="double">280</property>
      <property key="height" type="double">120</property>
    </gz-gui>
  </plugin>

  <plugin filename="MinimalScene" name="3D Scene">
    <gz-gui>
      <title>3D Scene</title>
      <property key="state" type="string">docked</property>
    </gz-gui>
    <engine>ogre</engine>
    <scene>scene</scene>
    <ambient_light>0.85 0.85 0.85</ambient_light>
    <background_color>0.75 0.82 0.92</background_color>
    <camera_pose>0 -85 55 0 0.45 1.57</camera_pose>
  </plugin>

  <plugin filename="WorldControl" name="World control">
    <gz-gui>
      <property key="state" type="string">floating</property>
      <property key="width" type="double">300</property>
      <property key="height" type="double">120</property>
    </gz-gui>
  </plugin>
</gui>
