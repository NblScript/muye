# 牧野生产环境模板
# 复制为 .env.production 后填写真实密钥；不要提交 .env.production。

# 本地 YOLO（生产入口会启动内嵌 API）
YOLO_API_URL="http://127.0.0.1:8010/detect"
YOLO_API_KEY=""
YOLO_CONFIDENCE_THRESHOLD="0.25"
YOLO_LOCAL_MODEL_PATH="models/best.pt"
YOLO_LOCAL_HOST="127.0.0.1"
YOLO_LOCAL_PORT="8010"
YOLO_ALLOWED_IPS=""

# 通义千问：真实模式必须填写兼容接口地址与密钥
QWEN_API_URL=""
QWEN_API_KEY=""
QWEN_MODEL="qwen-max"
QWEN_USE_MOCK="false"

# 和风天气：真实模式必须填写密钥
QWEATHER_API_KEY=""
QWEATHER_USE_MOCK="false"

# 可选外部服务
DEEPSEEK_API_URL=""
DEEPSEEK_API_KEY=""
XIAOMI_API_URL=""
XIAOMI_API_KEY=""

# 生产默认保持单代理，待验收多代理链路后再开启
MUYE_MULTI_AGENT_ENABLED="false"
MUYE_ROUTER_ENABLED="false"
RAG_ENABLED="true"

# PX4：real 通过 MAVSDK 连接 SITL 或真机；不会静默降级为动画
DRONE_BACKEND="px4"
MUYE_TAKEOFF_MODE="auto"
PX4_EXECUTION_MODE="real"
PX4_SYSTEM_ADDRESS="udpin://0.0.0.0:14540"
PX4_AUTO_START_ON_SPRAY="true"
PX4_ALLOW_FORCE_ARM="false"
PX4_REQUIRE_GLOBAL_POSITION="true"
PX4_AUTO_ARM="true"
PX4_AUTO_START_MISSION="true"
PX4_RETURN_TO_LAUNCH_AFTER_MISSION="true"

# 任务闭环
MUYE_EVALUATION_ENABLED="true"
MUYE_EVALUATION_AUTO_RETRY="true"
MUYE_EVALUATION_KILL_RATE_THRESHOLD="0.9"
MUYE_EVALUATION_MAX_RETRIES="3"
