# ===========================================
# Muye Backend Service
# 运行主处理流程 + YOLO API + Virtual Drone API + Frontend API
# ===========================================
FROM python:3.11-slim

WORKDIR /app

# 系统依赖（YOLO/ultralytics 需要）
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    && rm -rf /var/lib/apt/lists/*

# Python 依赖
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 源码
COPY app/ ./app/
COPY modules/ ./modules/
COPY models/ ./models/
COPY config/ ./config/
COPY scripts/ ./scripts/

# 入口脚本
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# 运行时目录
RUN mkdir -p /app/data/images /app/data/logs

# 环境变量
ENV PYTHONPATH=/app
ENV MUYE_SQLITE_PATH=/app/data/muye.db
ENV MUYE_API_PORT=8000

# 暴露端口
# 8000: Frontend API
# 8010: YOLO API (调试用)
# 9010: Virtual Drone API (调试用)
EXPOSE 8000 8010 9010

ENTRYPOINT ["/entrypoint.sh"]
