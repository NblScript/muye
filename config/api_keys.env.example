# 牧野 API 密钥配置模板
# 复制本文件为 api_keys.env 并填入真实密钥
# api_keys.env 已在 .gitignore 中排除，不会提交到 Git

# YOLO 检测服务
YOLO_API_URL="http://127.0.0.1:8010/detect"
YOLO_API_KEY="your-yolo-api-key"
YOLO_CONFIDENCE_THRESHOLD="0.25"
YOLO_LOCAL_MODEL_PATH="models/best.pt"
YOLO_LOCAL_HOST="127.0.0.1"
YOLO_LOCAL_PORT="8010"
YOLO_ALLOWED_IPS="127.0.0.1,::1"
YOLO_RATE_LIMIT_PER_MINUTE="120"

# Qwen AI 决策（DashScope 兼容模式）
QWEN_API_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
QWEN_API_KEY="your-qwen-api-key"
QWEN_MODEL="qwen-max-latest"
QWEN_USE_MOCK="false"

# DeepSeek AI（多智能体会诊）
DEEPSEEK_API_URL="https://api.deepseek.com/v1"
DEEPSEEK_API_KEY="your-deepseek-api-key"
DEEPSEEK_MODEL="deepseek-chat"

# 小米 AI（多智能体会诊）
XIAOMI_API_URL="https://api.xiaomimimo.com/v1/chat/completions"
XIAOMI_API_KEY="your-xiaomi-api-key"
XIAOMI_MODEL="mimo-v2.5-pro"

# 和风天气
QWEATHER_API_KEY="your-qweather-api-key"
QWEATHER_GEO_URL="https://geoapi.qweather.com/v2/city/lookup"
QWEATHER_WEATHER_URL="https://devapi.qweather.com/v7/weather/now"
QWEATHER_USE_MOCK="false"
QWEATHER_MOCK_TEMPERATURE="26"
QWEATHER_MOCK_HUMIDITY="58"
QWEATHER_MOCK_SUMMARY="多云"
QWEATHER_MOCK_WIND_DIRECTION="东南风"
QWEATHER_MOCK_WIND_SCALE="2"
QWEATHER_MOCK_WIND_SPEED="3.3"

# 无人机
DRONE_BACKEND="px4"
PX4_SYSTEM_ADDRESS="udpin://0.0.0.0:14540"
PX4_AUTO_START_ON_SPRAY="true"
SERVICE_CLIENT_IP="127.0.0.1"
