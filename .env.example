# ── YOLO 检测 ──
YOLO_API_URL="http://127.0.0.1:8010/detect"
YOLO_API_KEY=""
YOLO_CONFIDENCE_THRESHOLD="0.25"
YOLO_LOCAL_MODEL_PATH="models/best.pt"
YOLO_LOCAL_HOST="127.0.0.1"
YOLO_LOCAL_PORT="8010"
YOLO_ALLOWED_IPS=""
YOLO_RATE_LIMIT_PER_MINUTE="120"

# ── AI 决策（Qwen） ──
QWEN_API_URL=""
QWEN_API_KEY=""
QWEN_MODEL="qwen-max"
QWEN_USE_MOCK="false"

# ── 多智能体会诊（可选，MUYE_MULTI_AGENT_ENABLED=true 启用） ──
DEEPSEEK_API_URL="https://api.deepseek.com/v1"
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
XIAOMI_API_URL=""
XIAOMI_API_KEY=""
XIAOMI_MODEL=""

# ── 和风天气 ──
QWEATHER_API_KEY=""
QWEATHER_USE_MOCK="false"

# ── 无人机（DRONE_BACKEND 可选 px4 / dji_osdk） ──
DRONE_BACKEND="px4"
MUYE_TAKEOFF_MODE="auto"
PX4_SYSTEM_ADDRESS="udpin://0.0.0.0:14540"
PX4_AUTO_START_ON_SPRAY="true"
PX4_ALLOW_FORCE_ARM="true"
PX4_EXECUTION_MODE="animated_demo"

# ── RAG ──
RAG_ENABLED="true"

# ── 数据库（默认 ~/.muye/data/muye.db，一般不需要改） ──
# MUYE_SQLITE_PATH=""
